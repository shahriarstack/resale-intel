// Resale Intel — data model
// Commercial vehicle recovery → refurbishment → resale-ready pipeline.
// One vehicle passes through eight approving desks; status and letter stage
// are separate axes; every transition and edit is written to VehicleEvent.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  RECOVERY_TEAM // ARO / Sr. ARO — mobile
  RECOVERY_MANAGER // DM / AM — desktop
  SERVICE_ENGINEER // SE / Sr. SE — mobile
  SERVICE_HEAD // HQ — desktop
  REGISTRATION_TEAM // LO / Sr. LO / AM — desktop
  SR_EXECUTIVE // Sr. Ex — desktop
  AGM_DGM // desktop
  GM_SR_GM // desktop
  SALES_TEAM // MO / Sr. MO / TM / Sr. TM / AM — mobile, read-only

  // Holds no desk. Sees only what the Portal attached to their account
  // grants, and can act on none of it — see the Portal model.
  PORTAL_VIEWER // desktop, read-only
}

// The status axis: where the file sits in the eight-desk chain.
enum VehicleStatus {
  CAPTURED // held by Recovery Team
  RELEASED // TERMINAL — customer settled, vehicle returned
  CN_REQUESTED // held by Recovery Manager
  CN_APPROVED // held by Service Engineer
  COST_SUBMITTED // held by Service Head
  REPAIR_APPROVED // held by Registration Team — countdown live
  REGISTRATION_DONE // held by Sr. Executive
  SOP_ADDED // held by AGM / DGM
  PRICE_APPROVED // held by GM / Sr. GM
  LIVE_FOR_RESALE // on the resale marketplace — sales officers may bid
  SOLD // TERMINAL — a winning bid was awarded
}

// The letter axis: the escalation ladder, independent of status.
enum LetterStage {
  NONE
  LETTER_1
  LETTER_2
  LETTER_3
  WRITTEN
}

enum PhotoSlot {
  LEFT
  RIGHT
  FRONT
  BACK
  CABIN
  SLEEP
  ASSESSMENT_SHEET
  APPROVAL_SHEET // the Service Manager's repair approval sheet, attached when authorising the repair route
  REGISTRATION_DOC
  CAPTURE_FORM // photograph of the signed paper capture form
  REMARKS // optional: whatever the ARO wrote in the remarks, photographed

  // Handover set: the same five angles, re-shot by the Service Engineer once
  // the repair is finished. Separate slots rather than more rows in LEFT /
  // RIGHT / ... because the pairing is the point: every handover shot has an
  // exact counterpart from the day the vehicle was recovered, which is what
  // lets the engineer's screen show before-and-after and what lets the
  // marketplace say which state a photograph is actually of.
  HANDOVER_LEFT
  HANDOVER_RIGHT
  HANDOVER_FRONT
  HANDOVER_BACK
  HANDOVER_CABIN
}

// The recovery organisation is split in two, and each half owns a set of
// territories. Nullable: a newly created territory has not been assigned to a
// part yet, and forcing a guess at creation time would put wrong data in
// rather than leave a gap the coverage table can point at.
enum RecoveryPart {
  A
  B
}

enum LocationType {
  YARD
  DEPOT
  SHOWROOM
  CUSTOMER // not on our premises — the vehicle is still with the customer
  OTHER
}

// Condition grade set by the Sr. Executive.
enum VehicleGrade {
  A // Excellent
  B // Good
  C // Average
  D // Salvage
}

// How the vehicle was found at recovery.
//
// Distinct from VehicleGrade, which is a resale judgement made much later by
// the Sr. Executive after the repair. This is a fact the ARO observes at the
// roadside and it does not change: a vehicle recovered after an accident was
// recovered after an accident, whatever grade it eventually sells at.
//
// It is the single biggest predictor of what the assessment will cost, which
// is why it is captured at the front of the chain rather than inferred from
// photographs later.
enum VehicleCondition {
  ON_ROAD // drove, or could have driven, off the site
  OFF_ROAD // immobile but undamaged — mechanical, electrical, no fuel
  ACCIDENT // recovered damaged
}

// ---------------------------------------------------------------------------
// Off-road intake
//
// A vehicle leaves the road for one of three reasons, and only ONE of them is
// a resale event. Repossession puts a vehicle into the eight-desk chain;
// an accident normally ends with the vehicle back under its owner, and a
// police seizure normally ends with it released. Modelling all three as
// `Vehicle` rows would have given a truck that is going straight back to its
// customer a Costing row, a VehicleStatus and a place on the marketplace.
//
// So the two non-resale reasons live in `OffroadCase`, which tracks a vehicle
// that is off the road and nothing more. When such a case DOES turn into a
// repossession — an accident write-off, an abandoned seizure — it converts:
// a real Vehicle is created from it and the case closes pointing at it. That
// conversion is the single seam between off-road tracking and resale, and it
// is the only place the two meet.
// ---------------------------------------------------------------------------

// Which kind of off-road case this is. Deliberately ONE model with a
// discriminator rather than two tables: the two kinds share identity, the
// clock, photos, remarks and every one of their four outcomes, and the desk
// that watches them wants them in one list far more often than apart.
enum OffroadKind {
  ACCIDENT
  THANA // police station / legal custody
}

// The life of an off-road case. OPEN is the only state that consumes anyone's
// attention; the other three are the three ways a vehicle stops being our
// problem, and they are distinct because they mean different things to the
// business — one is a recovery, one is a loss of the asset back to the
// customer, one is the start of a resale.
enum OffroadCaseStatus {
  OPEN
  RESOLVED_ONROAD // repaired / released and back in service with the customer
  RELEASED_TO_CUSTOMER // handed back — case closed, no resale
  CONVERTED_TO_CAPTURE // became a repossession; see OffroadCase.vehicleId
}

// Why the vehicle is in police custody. A fixed list because the desk reports
// on it, plus OTHER carrying free text so an unusual case is recorded rather
// than forced into the nearest wrong bucket.
enum ThanaReason {
  ACCIDENT
  DRUG_CASE
  ILLEGAL_GOODS
  THEFT
  CUSTOMS
  OTHER
}

// How badly the vehicle is damaged, as judged at the roadside. Four rungs,
// because the ARO has to answer this from a photograph's worth of looking and
// a finer scale would only invent precision. TOTAL_LOSS is the rung that
// predicts a conversion to capture.
enum AccidentSeverity {
  MINOR // cosmetic / driveable
  MODERATE // needs workshop time, repairable
  MAJOR // extensive structural or mechanical damage
  TOTAL_LOSS // beyond economic repair
}

// A pre-approval to go and take a vehicle.
//
// The request exists because seizing a truck is not a field decision. The ARO
// assembles the account position, the manager rules on it, and only then does
// a capture happen — so the approval is on record BEFORE the vehicle moves,
// rather than being reconstructed afterwards from a Credit Note.
enum CaptureRequestStatus {
  PENDING // with the Recovery Manager
  APPROVED // the ARO may now capture
  DECLINED // refused, with a reason
  CAPTURED // the approval was used; see CaptureRequest.vehicleId
  WITHDRAWN // the ARO pulled it — customer paid, vehicle returned voluntarily
}

// How a vehicle entered the pipeline. Derivable from the two nullable
// relations below it, but kept as a column so a list can group by provenance
// without joining two tables it otherwise has no use for.
enum VehicleIntakeSource {
  DIRECT_CAPTURE // captured straight from the field
  APPROVED_REQUEST // captured against an approved CaptureRequest
  FROM_ACCIDENT // converted from an accident case
  FROM_THANA // converted from a police-custody case
  // Recorded during an open CaptureWindow — a vehicle already in hand before
  // the approval gate existed, entered under a named admin authorisation
  // instead of a request. Its own value rather than DIRECT_CAPTURE because
  // the whole point of the window is that these records are the exception and
  // must stay identifiable as such for as long as they exist.
  BACKFILL_CAPTURE
}

// The audit vocabulary for the two off-road flows. Separate from EventType
// because none of these move a VehicleStatus, and mixing them into the desk
// chain's vocabulary would have made every existing status query filter around
// events that can never carry a status.
enum RecoveryEventType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_DECLINED
  REQUEST_WITHDRAWN
  REQUEST_CAPTURED
  CASE_OPENED
  CASE_EDITED
  TIMELINE_REVISED
  MARKED_ONROAD
  CASE_RELEASED
  CASE_CONVERTED
  FLAG_RAISED
  FLAG_RESOLVED
}

// How far along a repair is, as reported by the Service Engineer doing it.
// Deliberately four plain stages rather than a percentage: a percentage invites
// invented precision ("about 60%"), whereas these are states an engineer can
// answer without thinking. AWAITING_PARTS is a stage rather than a separate
// blocker flag because it is by far the most common reason a repair stalls.
enum RepairStage {
  NOT_STARTED // legacy: kept because rows hold it; no longer offered
  IN_PROGRESS
  AWAITING_PARTS
  READY
}

/// Why a repair is blocked.
///
/// The stage says the work has stopped; this says what stopped it. Two values,
/// because an engineer standing next to a vehicle will pick from two and will
/// not pick from seven — and because the only distinction the workshop acts on
/// is "we are waiting for a thing to arrive" versus "something else is wrong",
/// which are chased by different people.
enum RepairBlocker {
  PARTS
  OTHER
}

// The audit vocabulary. Every row in VehicleEvent names one of these.
enum EventType {
  CAPTURED
  FIELD_EDITED
  LETTER_UPDATED
  ENGINEER_ASSIGNED
  RELEASED
  CN_REQUESTED
  CN_APPROVED
  CN_DECLINED
  ASSESSMENT_SUBMITTED
  REPAIR_APPROVED
  REPAIR_SENT_BACK
  REGISTRATION_COMPLETED
  SOP_SET
  SOP_UPDATED
  GRADED
  PRICE_SET
  PRICE_APPROVED
  PRICE_REVISED
  PUSHED_LIVE
  SENT_BACK
  LOCKED
  UNLOCKED
  BID_PLACED
  BID_REVISED
  BID_WITHDRAWN
  SALE_AWARDED
  REPAIR_PROGRESS

  // The Service Manager decided the vehicle sells in the condition it arrived
  // in. Its own event rather than a REPAIR_APPROVED with a flag: no repair was
  // authorised, so anything counting approved repairs would otherwise count a
  // repair that never happened.
  SOLD_AS_IS
  // The engineer closed the job with the five post-repair photographs.
  HANDOVER_SUBMITTED

  // Registration's standing watch over a vehicle's paperwork validity — set
  // the first time they complete registration, renewed independently of
  // wherever the file has since moved on to.
  REGISTRATION_VALIDITY_SET
  REGISTRATION_VALIDITY_RENEWED

  // The photographs on a sold vehicle were deleted under the post-sale
  // retention rule. Written BY the sweep, never by a person, and it is the
  // whole reason the deletion is not a silent hole in the record: the file
  // keeps the fact that there were images, how many, and when they went.
  PHOTOS_PURGED
}

// ---------------------------------------------------------------------------
// Users & master data
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  name         String
  staffId      String  @unique // login handle, e.g. "ARO-014"
  designation  String? // "ARO", "Sr. ARO", "DM" — free text within a role
  role         Role    @default(RECOVERY_TEAM)
  passwordHash String
  isActive     Boolean @default(true)

  // The sales patch this person covers.
  //
  // Deliberately NOT a Territory relation. Territory is the recovery
  // organisation's map — it carries RecoveryPart A/B and it is what an ARO
  // works. Sales runs its own geography, drawn differently, and pointing both
  // at one table would quietly assert they are the same thing. They are not.
  //
  // Plain text rather than a second master-data table because the admin needs
  // to type a name and move on; the user form offers what has already been
  // entered as suggestions, which keeps spelling consistent without making
  // anyone maintain a list.
  salesTerritory String? @db.VarChar(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehiclesCaptured Vehicle[]              @relation("CapturedVehicles")
  vehiclesAssigned Vehicle[]              @relation("AssignedEngineer")
  events           VehicleEvent[]
  photosUploaded   VehiclePhoto[]
  repairLines      RepairCostLine[]
  regLines         RegistrationCostLine[]
  bids             Bid[]
  offersCredited   Bid[]                  @relation("CreditedOffers")
  captureRequests  CaptureRequest[]       @relation("RequestedCaptures")
  captureDecisions CaptureRequest[]       @relation("DecidedCaptures")
  offroadOpened    OffroadCase[]          @relation("OpenedCases")
  offroadRevised   OffroadCase[]          @relation("RevisedCases")
  offroadPhotos    OffroadPhoto[]
  recoveryEvents   RecoveryEvent[]
  flagsRaised      CaseFlag[]             @relation("RaisedFlags")
  flagsResolved    CaseFlag[]             @relation("ResolvedFlags")
  windowsOpened    CaptureWindow[]        @relation("OpenedWindows")
  windowsClosed    CaptureWindow[]        @relation("ClosedWindows")
  portalsCreated   Portal[]               @relation("CreatedPortals")
  // Where this person works. One BASE posting and any number of COVER ones —
  // see TerritoryPosting. Replaces the single `territoryId` column, which
  // could not express an officer holding a vacant neighbouring patch.
  postings         TerritoryPosting[]

  // The lens this account reads through. Only ever set on a PORTAL_VIEWER,
  // and required on one — a portal viewer with no portal would be an account
  // that can sign in and see nothing, so the API refuses to create one.
  //
  // SetNull rather than Cascade: deleting a portal must not delete the people
  // who were reading through it. It strands them instead, which the portal
  // console reports and the admin resolves by reassigning or deactivating.
  portalId String?
  portal   Portal? @relation("PortalMembers", fields: [portalId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([isActive])
  @@index([portalId])
}

model Territory {
  id       String        @id @default(cuid())
  name     String        @unique
  code     String?
  part     RecoveryPart?
  isActive Boolean       @default(true)

  vehicles        Vehicle[]
  captureRequests CaptureRequest[]
  offroadCases    OffroadCase[]
  captureWindows  CaptureWindow[]
  portals         Portal[]           @relation("PortalTerritories")
  postings        TerritoryPosting[]

  @@index([part])
}

model Location {
  id       String       @id @default(cuid())
  name     String       @unique
  type     LocationType @default(YARD)
  isActive Boolean      @default(true)

  vehicles Vehicle[]
}

// Admin-managed vehicle brands, and the models under each.
//
// These are a PICK LIST, not a foreign key on Vehicle. The vehicle keeps the
// brand and model it was captured with as plain text (Vehicle.make /
// Vehicle.model), because that is a fact about the capture: renaming "Foton"
// here later must not silently rewrite what an ARO recorded last year. The
// tables govern what can be chosen, the vehicle records what was chosen.
model Brand {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  models VehicleModel[]
}

model VehicleModel {
  id        String  @id @default(cuid())
  brandId   String
  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // A model name only has to be unique within its brand — two makers may both
  // sell something called "1109".
  @@unique([brandId, name])
  @@index([brandId])
}

// Admin-managed capture checklist. "Registration Certificate: Yes/No" is one seed row.
model DocumentQuestion {
  id           String  @id @default(cuid())
  key          String  @unique // stable machine key, e.g. "REG_CERT"
  label        String
  requiresNote Boolean @default(false)
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  answers DocumentAnswer[]
}

// ---------------------------------------------------------------------------
// Vehicle
// ---------------------------------------------------------------------------

model Vehicle {
  id             String  @id @default(cuid())
  registrationNo String  @unique
  customerName   String
  customerCode   String?
  make           String?
  model          String?
  year           Int?
  mileage        String?

  // How it was found, at recovery. Nullable only because records captured
  // before this field existed cannot be back-filled honestly.
  condition VehicleCondition?

  status      VehicleStatus @default(CAPTURED)
  letterStage LetterStage   @default(NONE)
  grade       VehicleGrade? // condition grade set by Sr. Executive
  isLocked    Boolean       @default(false) // set when Letter 3 / Written issued

  // When each letter actually went out.
  //
  // `letterStage` says which rung the escalation has reached; these say when.
  // Both are needed and neither implies the other: the ladder is governed by a
  // schedule — Letter 1 the day after capture, Letter 2 seven days after
  // Letter 1, Letter 3 seven days after Letter 2 — and a schedule cannot be
  // computed from a stage alone. Without these columns "Letter 2 is overdue"
  // was a fact nobody could establish from the record.
  //
  // Nullable throughout, including behind a later stage: files captured before
  // this existed have a stage and no dates, and back-filling a legal notice
  // date with a guess is worse than admitting it is unknown.
  letter1At DateTime?
  letter2At DateTime?
  letter3At DateTime?

  // How this vehicle got here. See VehicleIntakeSource.
  intakeSource VehicleIntakeSource @default(DIRECT_CAPTURE)

  // The admin authorisation this capture was made under, when it was entered
  // during an open CaptureWindow instead of against an approved request. Set
  // for exactly the records whose intakeSource is BACKFILL_CAPTURE, and kept
  // for the life of the record: "who let this in without a request" must stay
  // answerable long after the window itself has closed.
  captureWindowId String?
  captureWindow   CaptureWindow? @relation(fields: [captureWindowId], references: [id], onDelete: SetNull)
  hasSleeperCabin Boolean        @default(false)
  remarks         String?        @db.Text

  // Case slip — a fine raised against the vehicle at capture.
  //
  // A first-class pair of columns rather than another DocumentQuestion,
  // because the answer carries money. DocumentAnswer stores a boolean and a
  // free-text note, so a fine recorded there could not be summed, compared or
  // rolled into a cost without parsing prose back into a number.
  hasCaseSlip  Boolean @default(false)
  caseSlipFine Float?

  // What the seizure itself cost the officer — recovery agent, transport on
  // the day, whatever had to be paid to get the vehicle moved. A couple of
  // thousand taka, typically.
  //
  // A RECORD, and nothing else. It is deliberately absent from
  // computeBreakdown, so it reaches no price, no margin and no approval: the
  // cost basis every desk works from is the money spent making the vehicle
  // sellable, and folding a field expense into it would silently move an
  // approved price that four people already signed. The Recovery Manager sees
  // it because it is their field spend to watch; nobody downstream does.
  //
  // Nullable rather than defaulted to zero: captures taken before this field
  // existed cost something, and writing zero would claim they were free.
  captureCost Float?

  territoryId       String?
  territory         Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  currentLocationId String?
  currentLocation   Location?  @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)

  // Somewhere not on the master list.
  //
  // A vehicle is often parked wherever it could be got to — a police compound,
  // the customer's own yard, a roadside. Forcing those into the Location table
  // would fill master data with one-off rows and typo duplicates of each other,
  // so a free-typed place is stored as text instead and the relation is left
  // null. Exactly one of the two is ever set; `locationName()` in lib/vehicle
  // is the only thing that should read them.
  currentLocationOther String?  @db.VarChar(120)
  capturedLocation     String? // free text — where the seizure happened
  captureDate          DateTime @default(now())

  capturedById String?
  capturedBy   User?   @relation("CapturedVehicles", fields: [capturedById], references: [id], onDelete: SetNull)

  assignedEngineerId String?
  assignedEngineer   User?   @relation("AssignedEngineer", fields: [assignedEngineerId], references: [id], onDelete: SetNull)

  // Registration paperwork validity.
  //
  // Separate from `status` above on purpose. Status is where the FILE sits in
  // the eight-desk chain, and it stops being Registration's concern the moment
  // they submit. This is a different clock — how long the physical paperwork
  // is good for — and Registration owns it for the vehicle's whole life, not
  // just while it happens to be on their desk. A vehicle can be sold and this
  // window still exists on the record; it simply stops being anyone's alarm
  // (see lib/registrationValidity.ts).
  //
  // Null until Registration completes the file once; every renewal after that
  // just moves `registrationValidUntil` forward and logs the change.
  registrationValidUntil DateTime?
  // The window most recently chosen, so the renew control can default to
  // "do that again" rather than back to a fixed number every time.
  registrationValidDays  Int?

  // Repair timeframe set by the Service Manager → drives the countdown /
  // overdue tracker. Null on an as-is vehicle: nothing was authorised, so
  // there is no deadline to run against.
  repairDeadline DateTime?

  // Sold in the condition it was recovered in.
  //
  // Set by the Service Manager instead of approving a repair. The file still
  // routes to Registration exactly as a repaired vehicle does — the desks
  // after this point are identical — so this is a flag rather than a new
  // status, which would have forked the whole state machine to express one
  // difference in meaning.
  //
  // Two things read it. Costing drops the repair estimate from the cost basis,
  // because that money is now never going to be spent. The marketplace falls
  // back to the recovery photographs, because there is no refurbished vehicle
  // to photograph. The engineer's repair lines are KEPT either way: on an
  // as-is vehicle they stop being a quotation and become the disclosed fault
  // list, which is the one thing an as-is buyer most needs.
  asIs Boolean @default(false)

  // Engineer-reported repair progress.
  //
  // Advisory ONLY. Nothing in the state machine reads these fields and no
  // transition is gated on them: the repair still moves on when Registration
  // completes, exactly as before. This exists so the person doing the work can
  // say where it has got to, and so the Service Head can see a stalled repair
  // before the deadline passes rather than after.
  //
  // The stamped values are the latest report, kept on the row so a list can
  // show it without a join. The full history lives in VehicleEvent.
  repairStage     RepairStage?
  repairStageNote String?      @db.Text
  repairStageAt   DateTime?
  // Set only while the stage is AWAITING_PARTS, and cleared when it moves on.
  // OTHER carries its explanation in `repairStageNote`, which the report
  // requires for that choice — "something else is wrong" is not a report.
  repairBlocker   RepairBlocker?
  // Plain column, like Costing.sopUpdatedById — the audit event already
  // carries the actor relation, this is only for a cheap "who last touched it".
  repairStageById String?

  // The end of the month this vehicle's SOP was priced for.
  //
  // A live vehicle past this instant is ON HOLD: still listed, no longer
  // biddable, waiting for the Sr. Executive to re-price it for the new month.
  // The hold is DERIVED from this timestamp rather than written by a scheduled
  // job — there is no cron to fail, no midnight batch to miss, and a vehicle
  // cannot end up half-held because a job died halfway through the table.
  resaleCycleEndsAt DateTime?

  // Resale outcome. winningBidId is a plain column, not a relation: a foreign
  // key back into Bid would form a cycle with Bid.vehicleId and block deletes.
  soldAt       DateTime?
  winningBidId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costing        Costing?
  // Provenance, when there is any. A vehicle captured straight from the field
  // has neither; one that came through an approval or a converted off-road
  // case has exactly one.
  captureRequest CaptureRequest?
  offroadCase    OffroadCase?
  photos         VehiclePhoto[]
  answers        DocumentAnswer[]
  repairLines    RepairCostLine[]
  regLines       RegistrationCostLine[]
  events         VehicleEvent[]
  bids           Bid[]

  @@index([status])
  @@index([letterStage])
  @@index([capturedById])
  @@index([assignedEngineerId])
  @@index([territoryId])
  @@index([repairDeadline])
}

model DocumentAnswer {
  id         String  @id @default(cuid())
  vehicleId  String
  questionId String
  answer     Boolean @default(false)
  note       String? @db.Text

  vehicle  Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  question DocumentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, questionId])
}

model VehiclePhoto {
  id           String    @id @default(cuid())
  vehicleId    String
  slot         PhotoSlot
  url          String
  uploadedById String?
  uploadedAt   DateTime  @default(now())

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Costing — one row per vehicle; line items roll up into it.
// ---------------------------------------------------------------------------

model Costing {
  id        String @id @default(cuid())
  vehicleId String @unique

  // The repair figure, as one number.
  //
  // It used to be the sum of RepairCostLine rows the engineer typed in one at
  // a time. In practice the itemisation was being copied off a written
  // estimate the workshop had already produced — so the app was asking someone
  // standing next to a vehicle to re-key a document they were holding, and the
  // document itself was the authoritative record either way.
  //
  // Now the engineer submits the total and uploads that estimate. The sheet is
  // the detail; this is the money. RepairCostLine survives, unwritten, so files
  // assessed under the old flow keep their breakdown (see the archive block on
  // the vehicle record).
  repairCost Float   @default(0)
  // What the work is, in a sentence. The sheet carries the itemisation; this
  // exists so the Service Manager approving the money, and an as-is listing
  // disclosing what was left undone, have something readable on screen.
  repairNote String? @db.Text

  transportCost Float @default(0)
  otherCost     Float @default(0)

  // Single editable SOP figure, revised monthly. History lives in VehicleEvent.
  sopCost        Float     @default(0)
  sopUpdatedAt   DateTime?
  sopUpdatedById String?

  // Commission payable to the dealer on a sale. A separate figure from SOP
  // because it is a different kind of money — SOP is what holding the vehicle
  // costs us, commission is what selling it costs us — and a carry-forward
  // vehicle has both revised, independently, each month.
  dealerCommission Float @default(0)

  approvedPrice Float?
  priceSetById  String?
  priceSetAt    DateTime?

  repairDays         Int?
  repairApprovedById String?
  repairApprovedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

/// ARCHIVE. No longer written: the engineer submits a single `repairCost`
/// plus an estimate sheet. Kept so vehicles assessed before that change do not
/// silently lose the breakdown they were approved on.
model RepairCostLine {
  id          String   @id @default(cuid())
  vehicleId   String
  description String
  amount      Float    @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  // Optional photo of the part or fault this line is charging for.
  //
  // Stores the upload NAME, not a URL: every other photo in the system is
  // served through /api/files/[name] behind auth, so keeping the name lets
  // that route validate it on the way back out, and a stored URL would break
  // the moment the serving path changed.
  photoName String?

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
}

model RegistrationCostLine {
  id          String   @id @default(cuid())
  vehicleId   String
  description String
  amount      Float    @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Customer offers
//
// An offer is a named CUSTOMER's price, submitted by a field officer on that
// customer's behalf. That is the whole reason one officer may hold several
// offers on one vehicle: they are not raising their own bid, they are walking
// three different buyers past the same truck.
//
// Sealed sideways, open upward. An officer reads only the offers they
// submitted; the desks that choose a buyer read the book whole — customer,
// officer, territory and the officer's level — because "who is this coming
// from" is half of what makes an offer worth taking.
//
// Nothing is ever deleted. A withdrawn offer is stamped, not removed, so the
// record of what was once on the table survives the officer changing their
// mind.
// ---------------------------------------------------------------------------

model Bid {
  id        String @id @default(cuid())
  vehicleId String
  bidderId  String

  // The buyer this offer is for. Nullable only because offers predating named
  // customers exist; every offer written since carries one.
  customerName String? @db.VarChar(160)

  amount Float
  note   String? @db.Text // remarks — payment terms, buyer interest, conditions

  createdAt   DateTime  @default(now())
  // Set when the officer corrects an offer in place. Null means never touched
  // since it was submitted.
  revisedAt   DateTime?
  // Set when the officer takes the offer off the table. A withdrawn offer is
  // hidden from the book and cannot be awarded, but it is still on record.
  withdrawnAt DateTime?

  // Who the offer is CREDITED to, when that is not the person who typed it.
  //
  // The sales team works one shared marketplace, so an offer may be entered by
  // whoever is at the screen on behalf of the officer whose customer it is.
  // Two columns rather than one, because they answer different questions and
  // conflating them loses both: `bidderId` is the audit fact — the account
  // that submitted, never editable — and `salesOfficerId` is the commercial
  // fact — whose customer this is, and therefore whose territory and whose
  // credit. Null means they are the same person.
  salesOfficerId String?

  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bidder       User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  salesOfficer User?   @relation("CreditedOffers", fields: [salesOfficerId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([bidderId])
  @@index([salesOfficerId])
  @@index([vehicleId, createdAt])
  @@index([vehicleId, withdrawnAt])
}

// ---------------------------------------------------------------------------
// Audit spine
// ---------------------------------------------------------------------------

model VehicleEvent {
  id        String    @id @default(cuid())
  vehicleId String
  actorId   String?
  type      EventType

  fromStatus VehicleStatus?
  toStatus   VehicleStatus?

  field    String? // for FIELD_EDITED / SOP_UPDATED / PRICE_REVISED
  oldValue String? @db.Text
  newValue String? @db.Text
  note     String? @db.Text // decline / send-back reasons

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Capture requests — the pre-approval gate in front of a repossession
//
// An ARO does not decide to take a truck; they make the case for taking one.
// This record is that case: the account position at the moment of asking, the
// manager's ruling on it, and — once used — a pointer to the vehicle that was
// actually captured against it.
//
// It is deliberately LIGHT. No photographs, no checklist, no engineer. Those
// are facts about a vehicle in our possession, and at request time the vehicle
// is still on the road; asking for them here would either be answered with
// guesses or block the request until after the thing it is meant to authorise.
// Everything heavy stays on the capture form, which runs after approval.
// ---------------------------------------------------------------------------

model CaptureRequest {
  id String @id @default(cuid())

  // Identity as the ARO knows it from the account file. Not unique: a customer
  // who settles and re-defaults is a second, honest request on the same
  // vehicle, and a unique index here would force the first one to be deleted
  // to allow the second — destroying the record of what was approved when.
  registrationNo String  @db.VarChar(60)
  customerCode   String  @db.VarChar(60)
  customerName   String  @db.VarChar(120)
  make           String?
  model          String?

  // The account position, as at the moment of asking.
  //
  // Stored as a snapshot rather than read live off the loan system: the
  // manager approved a seizure against THESE numbers, and a figure that keeps
  // moving afterwards would make it impossible to say later what the decision
  // was actually taken on.
  odNumber          Int // how many instalments are overdue
  odAmount          Float // value of those overdue instalments
  outstandingAmount Float // total still owed on the account

  // What the officer expects to happen AFTER the capture.
  //
  // Not "should we capture" — the request already asks for that, and both
  // answers here still end with the vehicle being taken. The distinction is
  // what the seizure is FOR: true means the officer expects the capture to
  // apply enough pressure that the customer clears the dues and the vehicle
  // goes back to them; false means they expect no further payment and little
  // chance of a voluntary return, so the file is headed for a Credit Note and
  // resale.
  //
  // Recorded for information only — it does not gate approval and nothing
  // computes from it. Its value is that the manager knows which of the two
  // they are authorising, and so does whoever reads the file later.
  settlementPossible Boolean

  remarks String @db.Text

  status CaptureRequestStatus @default(PENDING)

  requestedById String
  requestedBy   User     @relation("RequestedCaptures", fields: [requestedById], references: [id], onDelete: Cascade)
  requestedAt   DateTime @default(now())

  decidedById  String?
  decidedBy    User?     @relation("DecidedCaptures", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?   @db.Text

  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  // The capture made against this approval. Set once, when the ARO completes
  // the capture form off the back of it; unique because one approval
  // authorises one seizure.
  vehicleId String?  @unique
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  events RecoveryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requestedById])
  @@index([territoryId])
  @@index([requestedAt])
}

// ---------------------------------------------------------------------------
// Off-road cases — accident and police custody
//
// One model, two kinds. The shared columns are the ones both kinds answer
// identically (who, which vehicle, when it happened, how long it should take,
// what the ARO wants remembered); the kind-specific columns are nullable and
// enforced in the validation layer, not by the database, because MySQL has no
// way to say "these four are required only when kind = THANA" without a check
// constraint Prisma will not write.
// ---------------------------------------------------------------------------

model OffroadCase {
  id     String            @id @default(cuid())
  kind   OffroadKind
  status OffroadCaseStatus @default(OPEN)

  // --- Identity (both kinds) ---
  registrationNo String  @db.VarChar(60)
  customerCode   String  @db.VarChar(60)
  customerName   String  @db.VarChar(120)
  make           String?
  model          String?
  mileage        String? @db.VarChar(30)

  // --- The account position (both kinds) ---
  //
  // The same three figures a capture request carries, and for the same reason:
  // a vehicle off the road is money not being collected, and the desk cannot
  // rank one case against another without knowing how much is riding on each.
  //
  // Nullable, unlike on CaptureRequest. A capture request is written at a desk
  // with the account statement open; an accident case is opened at a roadside
  // with a damaged truck in front of the officer. Requiring the ledger there
  // would mean either a blocked form or three invented numbers, and an invented
  // outstanding is worse than an absent one.
  odNumber          Int? // how many instalments are overdue
  odAmount          Float? // value of those overdue instalments
  outstandingAmount Float? // total still owed on the account

  // --- The clock (both kinds) ---
  // When the vehicle went off the road: the accident date, or the date of
  // seizure.
  occurredAt DateTime
  // The ARO's estimate, in days, of how long it will be off the road — repair
  // time for an accident, time to clear the case for a seizure. This is what
  // the countdown runs against.
  approxDays Int

  // The manager's revision of that estimate.
  //
  // A second pair of columns rather than overwriting `approxDays`, because the
  // gap between the two IS the useful reading: a field estimate of ten days
  // that the desk keeps pushing to forty is a case going wrong, and that is
  // invisible if the revision erases what was first said.
  revisedDays Int?
  revisedById String?
  revisedBy   User?     @relation("RevisedCases", fields: [revisedById], references: [id], onDelete: SetNull)
  revisedAt   DateTime?

  remarks String @db.Text

  // --- Accident only ---
  accidentSeverity AccidentSeverity?
  // What is actually damaged, in the ARO's words. The severity rung is for
  // sorting; this is for the engineer who will eventually price it.
  accidentNote     String?           @db.Text

  // --- Thana / police custody only ---
  // The vehicle's own state, independent of why it is being held: a truck
  // seized over a customs dispute may be perfectly driveable.
  vehicleCondition VehicleCondition?
  thanaReason      ThanaReason?
  // Free text for OTHER, and for adding specifics to any of the listed
  // reasons — the case number, what was found, who filed it.
  thanaReasonNote  String?           @db.Text
  thanaName        String?           @db.VarChar(160)
  // Where the vehicle physically is. Free text, not a Location relation: a
  // police compound is not somewhere we operate and should not enter the yard
  // master list.
  vehicleLocation  String?           @db.VarChar(160)

  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  openedById String
  openedBy   User   @relation("OpenedCases", fields: [openedById], references: [id], onDelete: Cascade)

  // --- Resolution ---
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text
  // The No Objection Certificate reference, required before an accident or
  // seized vehicle may be converted into a repossession. Recorded as the
  // reference the ARO confirms they hold, because that is the thing an auditor
  // asks for and the thing that is missing when a conversion is challenged.
  nocReference   String?   @db.VarChar(120)

  // The vehicle created when this case converted to a capture.
  vehicleId String?  @unique
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  photos OffroadPhoto[]
  flags  CaseFlag[]
  events RecoveryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
  @@index([status])
  @@index([openedById])
  @@index([territoryId])
  @@index([occurredAt])
}

// Photographs on an off-road case.
//
// No PhotoSlot. The capture set is five fixed angles because every captured
// vehicle must be documented the same way for comparison; an accident is
// photographed wherever the damage is, and a seized vehicle is photographed
// through whatever the compound lets you get close to. Forcing those into
// LEFT/RIGHT/FRONT/BACK/CABIN would have produced five slots of the same
// crumpled corner.
model OffroadPhoto {
  id            String   @id @default(cuid())
  offroadCaseId String
  url           String
  caption       String?  @db.VarChar(160)
  uploadedById  String?
  uploadedAt    DateTime @default(now())

  offroadCase OffroadCase @relation(fields: [offroadCaseId], references: [id], onDelete: Cascade)
  uploadedBy  User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([offroadCaseId])
}

// The audit spine for both off-road flows — the same shape as VehicleEvent,
// pointed at whichever record the event belongs to. Exactly one of the two ids
// is set on any row.
model RecoveryEvent {
  id      String            @id @default(cuid())
  type    RecoveryEventType
  actorId String?
  actor   User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  captureRequestId String?
  captureRequest   CaptureRequest? @relation(fields: [captureRequestId], references: [id], onDelete: Cascade)

  offroadCaseId String?
  offroadCase   OffroadCase? @relation(fields: [offroadCaseId], references: [id], onDelete: Cascade)

  field    String?
  oldValue String? @db.Text
  newValue String? @db.Text
  note     String? @db.Text

  createdAt DateTime @default(now())

  @@index([captureRequestId])
  @@index([offroadCaseId])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Case flags — the two-way channel between the field and the desk
//
// An off-road case runs for weeks, and for most of that time neither side has
// anything to do: the vehicle is in a workshop or a compound and everyone is
// waiting. What both sides need is a way to say "this one, now" — and they
// need it in opposite directions.
//
// The officer standing next to the vehicle is the one who discovers that the
// workshop wants an authorisation nobody has given, or that the thana is
// asking for a document only HQ holds. They raise a SUPPORT_REQUEST.
//
// The manager watching thirty cases is the one who notices a clock that has
// run out, or a case nobody has touched in a fortnight. They raise an
// ATTENTION flag.
//
// Deliberately NOT a status on the case. A case can be flagged and unflagged
// several times over its life, by different people, for different reasons, and
// a column would keep only the last of those. It is also not a message thread:
// each flag is one ask with one resolution, which is what makes "how many are
// open" a question with an answer.
// ---------------------------------------------------------------------------

enum CaseFlagKind {
  SUPPORT_REQUEST // field → desk: "I am stuck, I need something"
  ATTENTION // desk → field: "look at this / act on this"
}

enum CaseFlagStatus {
  OPEN
  RESOLVED
}

model CaseFlag {
  id            String         @id @default(cuid())
  offroadCaseId String
  kind          CaseFlagKind
  status        CaseFlagStatus @default(OPEN)

  // What is being asked. Required on both kinds: a flag without a reason is a
  // notification, and a notification the recipient cannot act on is noise.
  note String @db.Text

  raisedById String
  raisedAt   DateTime @default(now())

  // Who closed it, and what they did. The resolver is the OTHER side: the desk
  // answers a support request, the officer answers an attention flag. Either
  // side may also withdraw its own — enforced in lib/rbac, not here.
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text

  offroadCase OffroadCase @relation(fields: [offroadCaseId], references: [id], onDelete: Cascade)
  raisedBy    User        @relation("RaisedFlags", fields: [raisedById], references: [id], onDelete: Cascade)
  resolvedBy  User?       @relation("ResolvedFlags", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([offroadCaseId])
  @@index([status, kind])
  @@index([raisedById])
}

// ---------------------------------------------------------------------------
// The direct-capture window.
//
// A capture normally has exactly one lawful origin: an approved CaptureRequest,
// or an off-road case that stopped being returnable. That gate is the point of
// the whole recovery flow — the manager rules on the account position BEFORE a
// vehicle is touched — and `POST /api/vehicles` refuses anything else.
//
// But the gate was built after the yard was already full. There is a real
// backlog of vehicles physically in hand that were seized before any of this
// existed, and there is no honest request to raise for them: nobody is going to
// pre-approve a seizure that happened last March.
//
// So rather than weaken the gate permanently, or let an admin paste a
// spreadsheet straight into the vehicle table with no officer and no
// provenance, an admin opens a WINDOW: a named, reasoned, time-boxed
// authorisation during which recovery officers may enter captures directly. The
// officer still fills the real capture form, still uploads the photographs,
// still answers the checklist — only the pre-approval is waived, and only for
// as long as the window is open.
//
// Four properties make this safe to hand out:
//
//   it EXPIRES        closesAt is mandatory, so an exception cannot quietly
//                     become the normal way in by being forgotten about
//   it is SCOPED      optionally to one territory, so a backlog in Khulna
//                     does not open the gate in Chittagong
//   it is CAPPED      maxCaptures bounds how much can come through
//   it is ATTRIBUTED  every vehicle made under it keeps a pointer back here
//                     and an intakeSource of BACKFILL_CAPTURE, permanently
//
// Which together mean the question "which records skipped the approval gate,
// who authorised that, and why" has an answer for as long as the data lives.
model CaptureWindow {
  id String @id @default(cuid())

  // Why this exception was granted. Required, and deliberately free text: the
  // reasons are one-offs by nature ("Aug 2026 yard reconciliation — 31 units
  // seized pre-system"), and a dropdown of canned reasons would only teach
  // people to pick the nearest one.
  reason String @db.Text

  // The window itself. `opensAt` defaults to now — an admin opening a window
  // is nearly always opening it for work happening today — but is settable so
  // one can be lined up for a Saturday reconciliation in advance.
  opensAt  DateTime @default(now())
  closesAt DateTime

  // How many captures may come through, in total, across every officer in
  // scope. Null means uncapped, which is allowed but is the loose setting:
  // an admin who knows the backlog is 31 units should say 31.
  maxCaptures Int?

  // Scope. Null means every recovery officer.
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  openedById String
  openedBy   User     @relation("OpenedWindows", fields: [openedById], references: [id], onDelete: Cascade)
  openedAt   DateTime @default(now())

  // Revoked before its own expiry. Distinct from simply having passed
  // `closesAt`: a window that ran its course and a window somebody shut early
  // are different events, and only one of them needs explaining later.
  closedById String?
  closedBy   User?     @relation("ClosedWindows", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt   DateTime?
  closeNote  String?   @db.Text

  // What came through it.
  vehicles Vehicle[]

  @@index([closesAt])
  @@index([territoryId])
}

// ---------------------------------------------------------------------------
// Portals — admin-authored read-only workspaces
// ---------------------------------------------------------------------------

// Which panel a portal may open. Each maps to one question a reader outside
// the eight desks actually asks, and to one panel built to answer it.
//
// Deliberately NOT a list of routes. A portal member never walks into a desk
// page: those pages carry the desk's own actions, its own assumptions about
// who is reading, and its own role guard, and widening them one by one to let
// a stranger in is how a read-only grant quietly becomes a write. The portal
// renders its own panels from its own query instead, so the only thing that
// has to be right is the scope — and it is applied once, in one place.
enum PortalModule {
  FLEET_REGISTER // every vehicle in scope, as a table
  RESALE_PIPELINE // where the book sits across the eight desks
  OFFROAD_FLEET // accidents and police custody, open cases
  SALES_MARGIN // what sold units fetched against what they cost
  TERRITORY_SPREAD // the same book cut by territory
  REPAIR_WATCH // repairs running against their deadline
  LETTER_LADDER // captures and where each sits on the letter schedule
  RECENT_ACTIVITY // the audit trail, filtered to scope
}

// Which slice of the fleet a portal may read. The two halves are the ones the
// business already recognises (see lib/status.ts) — a recovery reader and a
// resale reader are asking about different books, and most portals want one.
enum PortalBand {
  ALL
  CAPTURE // seized, letters running or Credit Note pending
  RESALE // past the Credit Note — stock being prepared and sold
}

// A portal's colour, from the system ramp. Presentation only: it is what makes
// one portal recognisable from another in a list, and it is echoed in the
// member's own header so they can tell at a glance which lens they are in.
enum PortalAccent {
  INDIGO
  JADE
  GARNET
  OCHRE
  TEAL
  PLUM
}

enum PortalGlyph {
  COMPASS
  CHART
  SHIELD
  BRIEFCASE
  BUILDING
  GLOBE
  WALLET
  CLIPBOARD
}

/// A named, admin-authored, read-only workspace.
///
/// The product has ten roles and every one of them is a desk: it holds files,
/// it owes a decision, and the transition table names it. That is the right
/// shape for the people running the pipeline and the wrong shape for everyone
/// who only ever needs to READ it — an auditor, a regional finance reader, a
/// board observer, a lender reviewing collateral. Minting a desk role for each
/// of them would put ten more rows in a table about decisions, for people who
/// make none.
///
/// A Portal is the other thing instead: a lens. An admin composes one by
/// answering three questions — what may it open, what may it see, and how much
/// of each record is legible — assigns people to it, and those people sign in
/// to exactly that and nothing else.
///
/// READ-ONLY BY CONSTRUCTION, not by a check. A portal member's role is
/// PORTAL_VIEWER, and no row of rbac.TRANSITIONS names PORTAL_VIEWER, so
/// `availableActions()` returns an empty list for them everywhere, already,
/// without a single new guard. Nothing about this model needs to be trusted
/// for that to hold: it follows from the transition table being the only way a
/// vehicle moves.
model Portal {
  id String @id @default(cuid())

  // What this lens is called, in the reader's language rather than ours —
  // "Board observer", "Chittagong finance", "Collateral audit". It is shown
  // to the member in their own header, so it should read as a place they
  // belong rather than as a permission set.
  name    String  @unique @db.VarChar(80)
  // Why it exists. Optional, and worth writing: a portal outlives the
  // conversation that created it.
  purpose String? @db.VarChar(200)

  // ---- What it may open -------------------------------------------------
  //
  // A PortalModule[], stored as JSON.
  //
  // MySQL has no scalar list, so the alternatives were eight boolean columns
  // or a join table to a table of eight fixed rows. Both spend a migration on
  // every new panel, and neither is more readable than the array they encode.
  // The shape is validated by `portalModulesSchema` on the way in and parsed
  // by `parseModules()` on the way out, so the cast happens in exactly one
  // place — see lib/portals.ts.
  modules Json

  // ---- What it may see --------------------------------------------------

  band PortalBand @default(ALL)

  // Empty means every territory. A picked list narrows the portal to those,
  // which is what makes a regional reader possible without a regional role.
  territories Territory[] @relation("PortalTerritories")

  // ---- How much of each record is legible -------------------------------
  //
  // Four lenses, each a real policy decision rather than a display toggle.
  // They are columns rather than more JSON because each one is a sentence an
  // admin may have to defend later, and a column is something you can query.

  /// Purchase, repair, registration, SOP — the cost basis, and margin with it.
  showCosts    Boolean @default(false)
  /// The customer's name, phone and address on a captured file.
  showCustomer Boolean @default(false)
  /// Offer amounts and who brought them in.
  showOffers   Boolean @default(false)
  /// Capture and handover photographs.
  showPhotos   Boolean @default(false)

  // ---- Presentation -----------------------------------------------------

  accent PortalAccent @default(INDIGO)
  glyph  PortalGlyph  @default(COMPASS)

  // ---- Lifecycle --------------------------------------------------------
  //
  // Suspending a portal is the reversible act and the one an admin nearly
  // always wants: it locks every member out at the next request without
  // touching their accounts or the composition of the lens. Deleting is
  // possible only once nobody is reading through it.
  isActive Boolean @default(true)

  members User[] @relation("PortalMembers")

  createdById String?
  createdBy   User?    @relation("CreatedPortals", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Territory postings — who works where
// ---------------------------------------------------------------------------

/// Why an officer holds a territory.
///
/// Two different facts, and a plain many-to-many would record them as one. An
/// officer BASED in Khulna and an officer COVERING Rajshahi because nobody is
/// posted there are not in the same relationship to those patches, and the
/// difference is the whole reason this table exists rather than a join of two
/// ids: a coverage board that showed Rajshahi with "two officers" would be
/// describing a vacancy as if it were a full staffing.
///
/// It also makes the end of the arrangement visible. A COVER posting on a
/// territory that has since gained a BASE officer is spent — the vacancy it
/// was created for has been filled — and the admin console can say so rather
/// than waiting for somebody to remember (see `staleCovers` in lib/postings).
enum PostingKind {
  BASE
  COVER
}

/// One officer's claim on one territory.
///
/// Replaces `User.territoryId`. A single column could not say that an officer
/// holds two patches, which happens whenever a territory is left unstaffed and
/// the neighbouring officer picks it up — a normal event in this organisation,
/// not an exception worth modelling around.
///
/// The pair is unique: holding the same territory twice is not a thing that can
/// be true, and letting it be storable would put duplicate officers on every
/// roll-up that reads this table.
model TerritoryPosting {
  id String @id @default(cuid())

  userId      String
  territoryId String

  // At most one BASE per officer, enforced by the users API rather than by the
  // database — MySQL has no partial unique index, and a CHECK cannot see other
  // rows. The invariant is written in exactly one place: `assertOneBase`.
  kind PostingKind @default(BASE)

  // When they picked it up. What makes a cover that has run for four months
  // legible as a staffing problem rather than as an arrangement.
  assignedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([userId, territoryId])
  @@index([territoryId])
  @@index([kind])
}
