# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/standalone.zip

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
#
# BOTH PATTERNS, and the second one is not redundant. `.env*` only matches
# names that START with ".env" — it does not match `server.env`, which held the
# production database password and session secret and was sitting untracked and
# committable. The remote is public GitHub; one `git add .` would have published
# them.
.env*
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded evidence (served from outside web root)
/uploads/
